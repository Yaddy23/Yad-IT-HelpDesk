# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (MongoDB Atlas — free cluster) ─────────────────────────────────
# Local dev uses the itsm_dev database on the same cluster
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/itsm_dev?retryWrites=true&w=majority

# ── Redis (Render Key Value — BullMQ queues, rate limiting) ─────────────────
# Local dev may point at the same instance; workers use key prefixes per env
REDIS_URL=rediss://default:PASSWORD@your-render-key-value.render.com:6379

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
REFRESH_EXPIRES_IN=7d
# One-time token that authorizes creating the first super admin; endpoint locks afterwards
SETUP_TOKEN=REPLACE_WITH_LONG_RANDOM_SETUP_TOKEN

# ── Background jobs ─────────────────────────────────────────────────────────
# true = BullMQ worker runs inside the API process (Render free tier)
WORKER_IN_PROCESS=true

# ── Email (optional — without credentials the app uses console-dev mode) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=helpdesk@example.com

# ── Client (Vite, dev only) ─────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
