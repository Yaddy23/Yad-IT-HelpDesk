# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (Supabase Postgres — free project) ─────────────────────────────
# Project Settings → Database → Connection string → URI (session pooler, port 5432).
# The local dev schema is applied via Prisma migrations.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# Direct (non-pooled) connection used by `prisma migrate` — same host without .pooler
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.supabase.com:5432/postgres
# Separate schema for integration tests (created automatically)
TEST_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ── Supabase Storage (attachments private bucket; server-side only) ─────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# ── Redis (Render Key Value — BullMQ queues, rate limiting) ─────────────────
REDIS_URL=rediss://default:PASSWORD@your-render-key-value.render.com:6379

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
REFRESH_EXPIRES_IN_DAYS=7
# One-time token that authorizes creating the first super admin; endpoint locks afterwards
SETUP_TOKEN=REPLACE_WITH_LONG_RANDOM_SETUP_TOKEN

# ── Background jobs ─────────────────────────────────────────────────────────
# true = BullMQ worker runs inside the API process (Render free tier)
WORKER_IN_PROCESS=true

# ── Email (optional — without credentials the app uses console-dev mode) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=helpdesk@example.com

# ── Client (Vite, dev only) ─────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
