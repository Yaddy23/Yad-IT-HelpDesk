// ITSM Platform — Prisma schema (source of truth for the Supabase Postgres database)
//
// Conventions:
// - Native PG enums for all status/role/priority vocabularies.
// - Append-only history tables (activities, assignments, audit_logs, decisions,
//   stock_movements, revisions) are never mutated — only inserted.
// - Multi-table invariants run inside transactions (see services).
// - Json is used ONLY for: catalog form schemas, audit snapshots, automation
//   rule definitions, and the configurable priority matrix.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/**
 * ── Identity & access ────────────────────────────────────────────────────
 */

enum Role {
  super_admin
  it_admin
  it_manager
  it_technician
  employee
  approver
}

model User {
  id                     String                   @id @default(cuid())
  email                  String                   @unique
  passwordHash           String
  name                   String
  active                 Boolean                  @default(true)
  employee               Employee?
  roles                  UserRole[]
  sessions               Session[]
  managedGroups          AssignmentGroup[]        @relation("groupManager")
  groupMemberships       AssignmentGroupMember[]  @relation("groupMemberships")
  auditEntries           AuditLog[]               @relation("auditActor")
  settingsModifications  SystemSettings[]         @relation("settingsModifier")
  ticketComments         TicketComment[]          @relation("ticketComments")
  ticketActivities       TicketActivity[]         @relation("ticketActivities")
  assignmentsMade        TicketAssignment[]       @relation("assignmentsMade")
  attachmentsUploaded    Attachment[]             @relation("attachmentUploader")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  assetsAssigned         AssetAssignment[]        @relation("assetAssigner")
  maintenanceRecorded    AssetMaintenanceRecord[] @relation("maintenanceRecorder")
  warrantyClaimsFiled    WarrantyClaim[]          @relation("warrantyClaimer")
  stockMovementsMade     StockMovement[]          @relation("stockMover")
  licensesAssigned       LicenseAssignment[]      @relation("licenseAssigner")
  auditsStarted          AssetAuditSession[]      @relation("auditStarter")
  auditsClosed           AssetAuditSession[]      @relation("auditCloser")
  assetsChecked          AssetAuditItem[]         @relation("assetChecker")
  approvalsRequested     ApprovalRequest[]        @relation("approvalsRequested")
  approvalDecisions      ApprovalDecision[]       @relation("approvalDecisions")
  lastLoginAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([active])
}

model UserRole {
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

/// Refresh-token sessions. Rotation revokes; reuse detection revokes the family.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/**
 * ── Organization ─────────────────────────────────────────────────────────
 */

enum EmploymentStatus {
  active
  on_leave
  inactive
  terminated
}

model Employee {
  id                 String              @id @default(cuid())
  employeeId         String              @unique
  userId             String?             @unique
  user               User?               @relation(fields: [userId], references: [id])
  name               String
  email              String
  departmentId       String?
  department         Department?         @relation("deptEmployees", fields: [departmentId], references: [id])
  jobTitle           String?
  managerId          String?
  manager            Employee?           @relation("mgrReports", fields: [managerId], references: [id])
  reports            Employee[]          @relation("mgrReports")
  locationId         String?
  location           Location?           @relation(fields: [locationId], references: [id])
  employmentStatus   EmploymentStatus    @default(active)
  phone              String?
  managedDepartments Department[]        @relation("deptManager")
  requestedTickets   Ticket[]            @relation("ticketRequester")
  assignedTickets    Ticket[]            @relation("ticketAssignee")
  assignmentHistory  TicketAssignment[]  @relation("assignmentAssignee")
  custodianAssets    Asset[]             @relation("assetCustodian")
  assetAssignments   AssetAssignment[]   @relation("assetAssignee")
  licenseAssignments LicenseAssignment[] @relation("licenseAssignee")
  serviceRequests    ServiceRequest[]    @relation("srRequester")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([departmentId])
  @@index([locationId])
  @@index([managerId])
}

model Department {
  id               String           @id @default(cuid())
  name             String
  code             String           @unique
  managerId        String?
  manager          Employee?        @relation("deptManager", fields: [managerId], references: [id])
  employees        Employee[]       @relation("deptEmployees")
  officeLocationId String?
  officeLocation   Location?        @relation("deptOffice", fields: [officeLocationId], references: [id])
  timezone         String           @default("UTC")
  supportGroupId   String?
  supportGroup     AssignmentGroup? @relation("deptSupport", fields: [supportGroupId], references: [id])
  assets           Asset[]          @relation("assetDepartment")
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Location {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  address        String?
  timezone       String          @default("UTC")
  active         Boolean         @default(true)
  employees      Employee[]
  departments    Department[]    @relation("deptOffice")
  assets         Asset[]         @relation("assetLocation")
  inventoryItems InventoryItem[] @relation("inventoryLocation")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum GroupRole {
  member
  lead
}

model AssignmentGroup {
  id                String                  @id @default(cuid())
  name              String
  code              String                  @unique
  description       String?
  managerId         String?
  manager           User?                   @relation("groupManager", fields: [managerId], references: [id])
  members           AssignmentGroupMember[]
  tickets           Ticket[]
  assignmentHistory TicketAssignment[]      @relation("assignmentGroup")
  departments       Department[]            @relation("deptSupport")
  active            Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

/// Membership history: removal sets leftAt (rows are never deleted).
model AssignmentGroupMember {
  id       String          @id @default(cuid())
  groupId  String
  group    AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation("groupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole       @default(member)
  joinedAt DateTime        @default(now())
  leftAt   DateTime?

  @@index([groupId, leftAt])
  @@index([userId])
}

/**
 * ── Platform ─────────────────────────────────────────────────────────────
 */

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("auditActor", fields: [actorId], references: [id])
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// Singleton row (key = 'global'). Json holds the configurable priority matrix.
model SystemSettings {
  id                     String   @id @default(cuid())
  key                    String   @unique @default("global")
  priorityMatrix         Json
  slaPauseStates         String[]
  reopenWindowDays       Int      @default(3)
  autoCloseResolvedDays  Int      @default(5)
  maxAutomationLoopDepth Int      @default(5)
  modifiedById           String?
  modifiedBy             User?    @relation("settingsModifier", fields: [modifiedById], references: [id])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model BusinessCalendar {
  id          String               @id @default(cuid())
  name        String
  timezone    String               @default("UTC")
  isDefault   Boolean              @default(false)
  active      Boolean              @default(true)
  workWindows CalendarWorkWindow[]
  holidays    CalendarHoliday[]
  slaPolicies SlaPolicy[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model CalendarWorkWindow {
  id         String           @id @default(cuid())
  calendarId String
  calendar   BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  day        Weekday
  start      String
  end        String

  @@index([calendarId])
}

enum Weekday {
  sun
  mon
  tue
  wed
  thu
  fri
  sat
}

model CalendarHoliday {
  id         String           @id @default(cuid())
  calendarId String
  calendar   BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  name       String?

  @@unique([calendarId, date])
}

/**
 * ── Service desk ─────────────────────────────────────────────────────────
 */

enum TicketStatus {
  new
  in_progress
  pending_employee
  pending_vendor
  resolved
  closed
  canceled
}

enum ImpactLevel {
  low
  medium
  high
}

enum UrgencyLevel {
  low
  medium
  high
}

enum PriorityLevel {
  low
  medium
  high
  critical
}

model Ticket {
  id                     String             @id @default(cuid())
  number                 String             @unique
  title                  String
  description            String
  category               String
  status                 TicketStatus       @default(new)
  impact                 ImpactLevel
  urgency                UrgencyLevel
  priority               PriorityLevel
  /// Set when an agent overrides the matrix-computed priority; audited.
  priorityOverrideReason String?
  requesterId            String
  requester              Employee           @relation("ticketRequester", fields: [requesterId], references: [id])
  assigneeId             String?
  assignee               Employee?          @relation("ticketAssignee", fields: [assigneeId], references: [id])
  groupId                String?
  group                  AssignmentGroup?   @relation(fields: [groupId], references: [id])
  resolutionNote         String?
  resolvedAt             DateTime?
  closedAt               DateTime?
  reopenedCount          Int                @default(0)
  /// Optimistic concurrency for state transitions.
  version                Int                @default(1)
  comments               TicketComment[]
  activities             TicketActivity[]
  assignments            TicketAssignment[]
  attachments            Attachment[]
  slaInstances           SlaInstance[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
  @@index([priority])
  @@index([assigneeId, status])
  @@index([groupId, status])
  @@index([requesterId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// Append-only assignment history: every assign/group change inserts a row.
model TicketAssignment {
  id           String           @id @default(cuid())
  ticketId     String
  ticket       Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assigneeId   String?
  assignee     Employee?        @relation("assignmentAssignee", fields: [assigneeId], references: [id])
  groupId      String?
  group        AssignmentGroup? @relation("assignmentGroup", fields: [groupId], references: [id])
  assignedById String
  assignedBy   User             @relation("assignmentsMade", fields: [assignedById], references: [id])
  note         String?
  createdAt    DateTime         @default(now())

  @@index([ticketId, createdAt(sort: Desc)])
  @@index([assigneeId])
  @@index([groupId])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("ticketComments", fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Append-only timeline: status changes, assignments, priority overrides, edits.
model TicketActivity {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("ticketActivities", fields: [actorId], references: [id])
  action    String
  /// Free-form snapshot (from/to states, priority changes, reasons…).
  detail    Json?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Sequence source for human ticket numbers (INC-YYYY-NNNNNN) — incremented
/// inside the create transaction so concurrent inserts stay gap-free & unique.
model TicketCounter {
  key  String @id @default("INC")
  next Int    @default(1)
}

/// File attached to a ticket. Bytes live in a PRIVATE Supabase Storage bucket;
/// downloads are mediated (short-lived signed URL, audited) — never public URLs.
model Attachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String
  sizeBytes    Int
  /// Bucket-relative object path, e.g. `tickets/{ticketId}/{uuid}/{filename}`.
  storagePath  String   @unique
  uploadedById String
  uploadedBy   User     @relation("attachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ticketId, createdAt])
}

/**
 * ── SLA engine ─────────────────────────────────────────────────────────────
 * Targets are stored as MINUTES of business time (real minutes when no
 * calendar is set). Elapsed = businessMs(startAt → now) − pausedMs; pause
 * intervals are converted to business ms on resume so overnight/weekend
 * pauses cost nothing. Deadlines are derived, never stored stale.
 */

enum SlaType {
  response
  resolution
}

enum SlaState {
  within
  approaching
  breached
  paused
  met
  missed
}

model SlaPolicy {
  id                 String            @id @default(cuid())
  name               String            @unique
  active             Boolean           @default(true)
  /// Match criteria `{ priorities?: string[], categories?: string[] }` — absent = match all.
  appliesTo          Json              @default("{}")
  /// Business minutes allowed for first response; null = no response target.
  responseTargetMins Int?
  /// Business minutes allowed to resolution; null = no resolution target.
  resolveTargetMins  Int?
  /// Percentage of the target at which the "approaching" warning fires.
  warnPercent        Int               @default(75)
  /// Null calendar = targets run on real (naive) time.
  businessCalendarId String?
  businessCalendar   BusinessCalendar? @relation(fields: [businessCalendarId], references: [id])
  instances          SlaInstance[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

/// One row per ticket × policy × target type. State is recomputed by the
/// sweep and on ticket events — the row is a materialized indicator.
model SlaInstance {
  id              String          @id @default(cuid())
  ticketId        String
  ticket          Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  policyId        String
  policy          SlaPolicy       @relation(fields: [policyId], references: [id])
  type            SlaType
  state           SlaState        @default(within)
  startAt         DateTime
  /// Target in business minutes (recomputed when priority/category changes).
  targetMins      Int
  pausedAt        DateTime?
  /// Accumulated paused time in BUSINESS ms (converted on resume).
  pausedMs        Int             @default(0)
  /// First agent response instant (completes the `response` instance).
  firstResponseAt DateTime?
  completedAt     DateTime?
  escalations     SlaEscalation[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([ticketId, policyId, type])
  @@index([state])
  @@index([ticketId])
}

/// Idempotency for escalation chains — the DB unique constraint makes double
/// fires impossible even if the sweep races or retries.
model SlaEscalation {
  id           String      @id @default(cuid())
  instanceId   String
  instance     SlaInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  /// e.g. "approaching" | "breached"
  thresholdKey String
  firedAt      DateTime    @default(now())

  @@unique([instanceId, thresholdKey])
}

/**
 * ── Notifications ──────────────────────────────────────────────────────────
 */
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  ticketId  String?
  /// Unique per logical event — a retried job cannot create a duplicate.
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt(sort: Desc)])
}

/// Per-user delivery preferences (per channel/category). Created on first read.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inApp        Boolean  @default(true)
  email        Boolean  @default(false)
  slaWarnings  Boolean  @default(true)
  slaBreaches  Boolean  @default(true)
  ticketUpdate Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

/// Append-only job execution log (successes and failures) for observability.
model JobRun {
  id        String   @id @default(cuid())
  queue     String
  name      String
  jobId     String
  status    String
  attempts  Int      @default(1)
  error     String?
  createdAt DateTime @default(now())

  @@index([name, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

/**
 * ── Asset management (Phase 4) ─────────────────────────────────────────────
 * Individually-tracked assets with a lifecycle (in_stock → deployed → …),
 * append-only custody assignments (one ACTIVE assignment per asset, enforced
 * at the DB level via the nullable-unique activeKey column), maintenance
 * schedules/records with vendor repairs, warranty claims, consumable
 * inventory with append-only stock movements, software license seats, and
 * physical audit sessions.
 */

enum AssetCategory {
  hardware
  mobile
  peripheral
  network
  appliance
  other
}

enum AssetStatus {
  in_stock
  deployed
  in_repair
  in_maintenance
  retired
  lost
}

model AssetCounter {
  key  String @id @default("AST")
  next Int    @default(1)
}

model Asset {
  id             String        @id @default(cuid())
  /// Human number, e.g. AST-2026-000001.
  number         String        @unique
  name           String
  category       AssetCategory @default(hardware)
  status         AssetStatus   @default(in_stock)
  manufacturer   String?
  model          String?
  serialNumber   String?
  purchasedAt    DateTime?
  purchaseCost   Float?
  warrantyExpiry DateTime?
  notes          String?

  custodianId  String?
  custodian    Employee?   @relation("assetCustodian", fields: [custodianId], references: [id])
  locationId   String?
  location     Location?   @relation("assetLocation", fields: [locationId], references: [id])
  departmentId String?
  department   Department? @relation("assetDepartment", fields: [departmentId], references: [id])
  vendorId     String?
  vendor       Vendor?     @relation("assetVendor", fields: [vendorId], references: [id])

  assignments          AssetAssignment[]
  maintenanceRecords   AssetMaintenanceRecord[]
  maintenanceSchedules MaintenanceSchedule[]
  warrantyClaims       WarrantyClaim[]
  auditItems           AssetAuditItem[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status])
  @@index([category])
  @@index([custodianId])
  @@index([locationId])
}

enum AssetAssignmentStatus {
  active
  returned
}

/// Append-only custody history. `activeKey` is the DB-level "one active
/// assignment per asset" constraint: set to the assetId while the assignment
/// is active, NULL once returned (a nullable-unique column is Prisma's
/// equivalent of a partial unique index).
model AssetAssignment {
  id             String                @id @default(cuid())
  assetId        String
  asset          Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee              @relation("assetAssignee", fields: [employeeId], references: [id])
  status         AssetAssignmentStatus @default(active)
  assignedById   String
  assignedBy     User                  @relation("assetAssigner", fields: [assignedById], references: [id])
  assignedAt     DateTime              @default(now())
  /// Loans carry a due-back date.
  dueAt          DateTime?
  acknowledgedAt DateTime?
  returnedAt     DateTime?
  returnNote     String?
  note           String?
  activeKey      String?               @unique

  @@index([assetId, assignedAt(sort: Desc)])
  @@index([employeeId, status])
}

/// Recurring maintenance plan for an asset (e.g. "every 90 days").
model MaintenanceSchedule {
  id              String    @id @default(cuid())
  assetId         String
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name            String
  intervalDays    Int
  active          Boolean   @default(true)
  nextDueAt       DateTime
  lastCompletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  records AssetMaintenanceRecord[]

  @@index([assetId])
  @@index([nextDueAt])
}

enum MaintenanceType {
  preventive
  repair
  inspection
  upgrade
}

/// Append-only maintenance history, including vendor repairs (vendorId set).
model AssetMaintenanceRecord {
  id          String               @id @default(cuid())
  assetId     String
  asset       Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  scheduleId  String?
  schedule    MaintenanceSchedule? @relation(fields: [scheduleId], references: [id])
  type        MaintenanceType      @default(preventive)
  performedAt DateTime             @default(now())
  summary     String
  cost        Float?
  vendorId    String?
  vendor      Vendor?              @relation("maintenanceVendor", fields: [vendorId], references: [id])
  performedBy String? /// free-text technician name for external work
  createdById String
  createdBy   User                 @relation("maintenanceRecorder", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  @@index([assetId, performedAt(sort: Desc)])
}

enum WarrantyClaimStatus {
  open
  submitted
  approved
  rejected
  resolved
}

model WarrantyClaim {
  id          String              @id @default(cuid())
  assetId     String
  asset       Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendorId    String?
  vendor      Vendor?             @relation("warrantyVendor", fields: [vendorId], references: [id])
  issue       String
  claimedAt   DateTime            @default(now())
  status      WarrantyClaimStatus @default(open)
  resolution  String?
  resolvedAt  DateTime?
  createdById String
  createdBy   User                @relation("warrantyClaimer", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())

  @@index([assetId])
  @@index([status])
}

/// Third-party vendor (repairs, warranty, purchases).
model Vendor {
  id             String                   @id @default(cuid())
  name           String
  contact        String?
  email          String?
  phone          String?
  notes          String?
  active         Boolean                  @default(true)
  assets         Asset[]                  @relation("assetVendor")
  maintenance    AssetMaintenanceRecord[] @relation("maintenanceVendor")
  warrantyClaims WarrantyClaim[]          @relation("warrantyVendor")
  licenses       SoftwareLicense[]        @relation("licenseVendor")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

enum StockMovementType {
  in
  out
  adjust
}

/// Consumable inventory. `quantity` is maintained transactionally alongside
/// append-only movements; a movement that would take it negative is blocked
/// in-transaction.
model InventoryItem {
  id           String    @id @default(cuid())
  name         String
  sku          String?   @unique
  category     String?
  unit         String    @default("pcs")
  quantity     Int       @default(0)
  reorderPoint Int       @default(0)
  unitCost     Float?
  locationId   String?
  location     Location? @relation("inventoryLocation", fields: [locationId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  movements StockMovement[]

  @@index([quantity])
}

/// Append-only stock history. `delta` is signed (+in/−out); `adjust` sets the
/// level to `resultingQuantity` (delta = new − old).
model StockMovement {
  id                String            @id @default(cuid())
  itemId            String
  item              InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type              StockMovementType
  delta             Int
  resultingQuantity Int
  reason            String
  ticketId          String? /// consumed by a ticket, optional link
  createdById       String
  createdBy         User              @relation("stockMover", fields: [createdById], references: [id])
  createdAt         DateTime          @default(now())

  @@index([itemId, createdAt(sort: Desc)])
}

enum LicenseType {
  perpetual
  subscription
  oem
  volume
}

model SoftwareLicense {
  id         String      @id @default(cuid())
  name       String
  vendorId   String?
  vendor     Vendor?     @relation("licenseVendor", fields: [vendorId], references: [id])
  licenseKey String?
  type       LicenseType @default(perpetual)
  seats      Int         @default(1)
  expiresAt  DateTime?
  cost       Float?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  assignments LicenseAssignment[]

  @@index([expiresAt])
}

enum LicenseAssignmentStatus {
  active
  returned
}

/// Seat assignment; same nullable-unique trick as AssetAssignment — at most
/// one active assignment per (license, employee) and seat count checked
/// transactionally at assignment time.
model LicenseAssignment {
  id           String                  @id @default(cuid())
  licenseId    String
  license      SoftwareLicense         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee                @relation("licenseAssignee", fields: [employeeId], references: [id])
  status       LicenseAssignmentStatus @default(active)
  assignedById String
  assignedBy   User                    @relation("licenseAssigner", fields: [assignedById], references: [id])
  assignedAt   DateTime                @default(now())
  returnedAt   DateTime?
  note         String?
  activeKey    String?                 @unique

  @@index([licenseId, status])
  @@index([employeeId])
}

enum AssetAuditItemStatus {
  found
  missing
  unexpected
}

/// A physical audit: open a session scoped to a location/department, mark each
/// expected asset found/missing, close the session (missing assets flagged).
model AssetAuditSession {
  id          String    @id @default(cuid())
  name        String
  status      String    @default("open") /// open | closed
  scopeType   String? /// location | department | all
  scopeId     String?
  startedById String
  startedBy   User      @relation("auditStarter", fields: [startedById], references: [id])
  startedAt   DateTime  @default(now())
  closedAt    DateTime?
  closedById  String?
  closedBy    User?     @relation("auditCloser", fields: [closedById], references: [id])

  items AssetAuditItem[]

  @@index([status, startedAt(sort: Desc)])
}

model AssetAuditItem {
  id          String                @id @default(cuid())
  sessionId   String
  session     AssetAuditSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status      AssetAuditItemStatus?
  checkedById String?
  checkedBy   User?                 @relation("assetChecker", fields: [checkedById], references: [id])
  checkedAt   DateTime?
  note        String?

  @@unique([sessionId, assetId])
}

/**
 * ── Service management (Phase 5) ─────────────────────────────────────────────
 * Catalog items define requestable services (jsonb form schemas — the one
 * genuinely schemaless place). Submitting a request instantiates approval
 * steps from the item's rule; decisions are append-only and the DB-unique
 * (request, step, approver) constraint makes duplicate decisions impossible.
 * `in_fulfillment` is reachable ONLY from an approved approval request —
 * the service-layer gate plus the state machine both enforce it.
 */

enum ServiceRequestStatus {
  pending_approval
  info_requested
  in_fulfillment
  fulfilled
  rejected
  canceled
}

model CatalogItem {
  id           String           @id @default(cuid())
  name         String
  description  String?
  category     String?
  icon         String?
  sortOrder    Int              @default(0)
  active       Boolean          @default(true)
  /// Eligibility `{ departments?: id[], locations?: id[], roles?: Role[] }` —
  /// absent/empty = everyone may request.
  eligibility  Json?
  /// Field definitions `[{ name, label, type, required?, options?, help? }]`.
  formSchema   Json
  requests     ServiceRequest[]
  approvalRule ApprovalRule?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([active, sortOrder])
}

model ServiceRequestCounter {
  key  String @id @default("SR")
  next Int    @default(1)
}

model ServiceRequest {
  id                String               @id @default(cuid())
  /// Human number, e.g. SR-2026-000001.
  number            String               @unique
  catalogItemId     String
  catalogItem       CatalogItem          @relation(fields: [catalogItemId], references: [id])
  requesterId       String
  requester         Employee             @relation("srRequester", fields: [requesterId], references: [id])
  status            ServiceRequestStatus @default(pending_approval)
  /// Form answers, validated against the item's formSchema at submission.
  answers           Json
  /// Info-request rounds `[{ round, note, at }]` appended per cycle.
  infoRequests      Json?
  approval          ApprovalRequest?     @relation(fields: [approvalRequestId], references: [id])
  rejectionReason   String?
  fulfilledAt       DateTime?
  fulfillNote       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  /// One approval per request — enforced at the DB level.
  approvalRequestId String? @unique

  @@index([status])
  @@index([requesterId, createdAt(sort: Desc)])
}

enum ApprovalStepMode {
  single
  all
  any
  sequential
}

enum ApprovalRequestStatus {
  pending
  approved
  rejected
  canceled
}

enum DecisionValue {
  approved
  rejected
  info_requested
}

/// One rule per catalog item (nullable-unique). Steps are authored as jsonb:
/// `[{ name, mode, approver: { type: user|manager|role, value? }, deadlineHours? }]`
/// and instantiated onto each request at submission.
model ApprovalRule {
  id            String       @id @default(cuid())
  name          String
  catalogItemId String?      @unique
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  steps         Json
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model ApprovalRequest {
  id              String                @id @default(cuid())
  /// Extensible: 'service_request' today, 'change' when Phase 5 change mgmt lands.
  targetType      String                @default("service_request")
  targetId        String
  status          ApprovalRequestStatus @default(pending)
  /// Instantiated steps, ordered. Completion advances `currentStep`.
  steps           Json
  currentStep     Int                   @default(0)
  requestedById   String
  requestedBy     User                  @relation("approvalsRequested", fields: [requestedById], references: [id])
  /// Delegations `{ [stepIndex]: delegateUserId }` — the delegate decides in the
  /// original candidate's place; the decision row records who actually decided.
  delegations     Json?
  decidedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  decisions       ApprovalDecision[]
  serviceRequests ServiceRequest[]

  @@index([targetType, targetId])
  @@index([status])
}

/// Append-only. Unique (request, step, approver) — a duplicated decision
/// (retry, double-click, racing tab) is impossible at the DB level.
model ApprovalDecision {
  id         String          @id @default(cuid())
  requestId  String
  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepIndex  Int
  approverId String
  approver   User            @relation("approvalDecisions", fields: [approverId], references: [id])
  decision   DecisionValue
  reason     String?
  createdAt  DateTime        @default(now())

  /// Uniqueness is a PARTIAL index (migration 20261023110000): one terminal
  /// decision (approved/rejected) per (request, step, approver), while
  /// info_requested rows may stack as the info-round history.
  @@index([requestId, stepIndex, approverId])
  @@index([approverId])
}
