    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.0",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
